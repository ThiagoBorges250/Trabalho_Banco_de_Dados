# ===== PREENCHA OS VALORES ABAIXO (nao envie este arquivo para o GitHub) =====

# Django
SECRET_KEY=COLOQUE_UMA_CHAVE_SECRETA_AQUI
DEBUG=False

# Supabase - Postgres (Project Settings > Database > Connection string)
# Para Render/hosts sem IPv6, use a URL do "Session pooler" (porta 5432 ou 6543).
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA_SUPABASE@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# Supabase - API (Project Settings > API) - opcional
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_KEY=COLOQUE_A_ANON_OU_SERVICE_ROLE_KEY_AQUI

# Redis (formato: redis://:SENHA@HOST:PORTA/0  ou rediss:// se tiver TLS)
REDIS_URL=redis://:SUA_SENHA_REDIS@SEU_HOST_REDIS:6379/0
